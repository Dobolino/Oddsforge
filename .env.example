# Copy to .env and fill in. Never commit .env.
# All variables are prefixed with QUANTBOT_.

# --- Runtime ---
QUANTBOT_ENV=development
QUANTBOT_LOG_LEVEL=INFO
QUANTBOT_LOG_JSON=false

# --- Data provider API keys (optional in MVP, DummyDataProvider needs none) ---
QUANTBOT_FOOTBALL_DATA_API_KEY=
QUANTBOT_API_FOOTBALL_API_KEY=
QUANTBOT_THE_ODDS_API_KEY=

# --- Value & decision thresholds ---
QUANTBOT_MIN_EDGE=0.03
QUANTBOT_MIN_DATA_QUALITY=60.0
QUANTBOT_MIN_MODEL_CONFIDENCE=55.0
# Conservative fractional Kelly (default 0.10 — not a loss guarantee).
QUANTBOT_KELLY_FRACTION=0.10

# --- Market engine ---
QUANTBOT_MARGIN_METHOD=shin

# --- Experimental (P2) ---
# Asian Handicap signals stay off until an AH ValidationArtifact exists.
QUANTBOT_ENABLE_AH_EXPERIMENTAL=false
